      "id": "c14d1274-a53f-4900-b7eb-2f7a918f93d7",
      "name": "Carregar pagina AJAX",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -540,
        220
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const page = $json.page ?? null;\nconst raw = $json.body ?? $json.data ?? $json.response ?? '';\nconst html = typeof raw === 'string' ? raw : JSON.stringify(raw || '');\n\nconst regex = /https:\\/\\/www\\.melnick\\.com\\.br\\/enterprise\\/[A-Za-z0-9\\-_/]+/gi;\nconst found = new Set();\n\nwhile (true) {\n  const match = regex.exec(html);\n  if (!match) break;\n  const clean = match[0].replace(/[\"'<>]/g, '').replace(/\\/$/, '') + '/';\n  found.add(clean);\n}\n\nif (!found.size) {\n  return [{\n    json: {\n      page,\n      found: false,\n      empreendimentoUrl: null,\n      debugLen: html.length,\n      debugStart: html.slice(0, 180)\n    }\n  }];\n}\n\nreturn [...found].map((url) => ({\n  json: {\n    page,\n    empreendimentoUrl: url,\n    found: true,\n    debugLen: html.length\n  }\n}));"
      },
      "id": "6c1a660e-fb73-4d34-8ab8-0bf61b482f5e",
      "name": "Extrair links por pagina",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        220
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const urls = new Set();\nconst pages = new Set();\n\nfor (const item of items) {\n  const j = item.json || {};\n  if (j.page != null) pages.add(j.page);\n  if (j.empreendimentoUrl) urls.add(j.empreendimentoUrl);\n}\n\nconst links = [...urls].sort();\n\nif (!links.length) {\n  return [{\n    json: {\n      etapa: 1,\n      status: 'sem_links_encontrados',\n      observacao: 'Sem links /enterprise/ nas paginas AJAX retornadas.',\n      pagesConsultadas: pages.size\n    }\n  }];\n}\n\nreturn links.map((url, index) => ({\n  json: {\n    etapa: 1,\n    indice: index + 1,\n    totalEncontrado: links.length,\n    pagesConsultadas: pages.size,\n    empreendimentoUrl: url,\n    origem: 'ajax_enterprises'\n  }\n}));"
      },
