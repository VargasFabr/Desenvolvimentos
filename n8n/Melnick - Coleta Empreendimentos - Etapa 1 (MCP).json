    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const maxPages = Number(items?.[0]?.json?.maxPages ?? 30);\nconst out = [];\nfor (let page = 1; page <= maxPages; page++) {\n  out.push({ json: { page, search_mode: page > 1 ? 'more' : '' } });\n}\nreturn out;"
      },
